<nav class="bg-white shadow-sm border-b border-gray-200 relative z-50">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between items-center">
      <!-- Left: Logo and Workspace Switcher -->
      <div class="flex items-center space-x-6">
        <!-- Logo -->
        <%= link_to root_path, class: "flex items-center space-x-2 group" do %>
          <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-indigo-600 to-indigo-700 flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow duration-200">
            <span class="text-white font-bold text-lg">A</span>
          </div>
          <span class="text-xl font-bold text-gray-900 group-hover:text-indigo-600 transition-colors duration-200">AEO</span>
        <% end %>

        <!-- Workspace Switcher -->
        <% if current_workspace.present? %>
          <div class="hidden sm:block relative" data-controller="dropdown">
            <button type="button"
                    data-action="click->dropdown#toggle"
                    class="group flex items-center space-x-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:border-gray-300 hover:bg-gray-50 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-150"
                    aria-label="Switch workspace"
                    aria-haspopup="true">
              <svg class="h-4 w-4 text-gray-400 group-hover:text-gray-500 transition-colors duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 002 4.25v2.5A2.25 2.25 0 004.25 9h2.5A2.25 2.25 0 009 6.75v-2.5A2.25 2.25 0 006.75 2h-2.5zm0 9A2.25 2.25 0 002 13.25v2.5A2.25 2.25 0 004.25 18h2.5A2.25 2.25 0 009 15.75v-2.5A2.25 2.25 0 006.75 11h-2.5zm9-9A2.25 2.25 0 0011 4.25v2.5A2.25 2.25 0 0013.25 9h2.5A2.25 2.25 0 0018 6.75v-2.5A2.25 2.25 0 0015.75 2h-2.5zm0 9A2.25 2.25 0 0011 13.25v2.5A2.25 2.25 0 0013.25 18h2.5A2.25 2.25 0 0018 15.75v-2.5A2.25 2.25 0 0015.75 11h-2.5z" clip-rule="evenodd" />
              </svg>
              <span class="max-w-[150px] truncate"><%= current_workspace.name %></span>
              <svg class="h-4 w-4 text-gray-400 group-hover:text-gray-500 transition-colors duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div data-dropdown-target="menu"
                 class="hidden absolute left-0 z-10 mt-2 w-72 origin-top-left rounded-lg bg-white shadow-xl ring-1 ring-black ring-opacity-5 focus:outline-none"
                 role="menu"
                 aria-orientation="vertical">
              <div class="py-2">
                <div class="px-4 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                  Your Workspaces
                </div>
                <div class="mt-1 max-h-60 overflow-y-auto">
                  <% current_user.workspaces.each do |workspace| %>
                    <%= link_to "#",
                        class: "group flex items-center justify-between px-4 py-2.5 text-sm hover:bg-gray-50 transition-colors duration-150 #{workspace == current_workspace ? 'bg-indigo-50' : ''}" do %>
                      <div class="flex items-center space-x-3 flex-1 min-w-0">
                        <div class="flex-shrink-0">
                          <div class="h-8 w-8 rounded-md bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center shadow-sm">
                            <span class="text-white font-semibold text-xs"><%= workspace.name[0..1].upcase %></span>
                          </div>
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="font-medium truncate #{workspace == current_workspace ? 'text-indigo-700' : 'text-gray-900 group-hover:text-gray-900'}">
                            <%= workspace.name %>
                          </p>
                          <p class="text-xs text-gray-500 mt-0.5">
                            <%= pluralize(workspace.users.count, 'member') %>
                          </p>
                        </div>
                      </div>
                      <% if workspace == current_workspace %>
                        <svg class="h-5 w-5 text-indigo-600 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                        </svg>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
                <div class="border-t border-gray-100 mt-2"></div>
                <%= link_to "#",
                    class: "group flex items-center space-x-2 px-4 py-2.5 text-sm text-indigo-600 hover:bg-indigo-50 font-medium transition-colors duration-150" do %>
                  <svg class="h-5 w-5 group-hover:scale-110 transition-transform duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                  </svg>
                  <span>Create New Workspace</span>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right: User Menu -->
      <div class="flex items-center space-x-3">
        <!-- Notifications (placeholder) -->
        <button type="button"
                class="hidden sm:flex relative rounded-lg p-2 text-gray-400 hover:text-gray-500 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-150"
                aria-label="View notifications">
          <span class="sr-only">View notifications</span>
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
          </svg>
          <!-- Notification badge (example) -->
          <span class="absolute top-1.5 right-1.5 block h-2 w-2 rounded-full bg-red-500 ring-2 ring-white"></span>
        </button>

        <!-- User Dropdown -->
        <div class="relative" data-controller="dropdown">
          <button type="button"
                  data-action="click->dropdown#toggle"
                  class="group flex items-center space-x-2 rounded-lg px-2 py-1.5 text-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-150"
                  aria-label="Open user menu"
                  aria-haspopup="true">
            <div class="h-9 w-9 rounded-full bg-gradient-to-br from-indigo-600 to-indigo-700 flex items-center justify-center text-white font-semibold shadow-sm group-hover:shadow-md transition-shadow duration-150">
              <%= current_user.initials %>
            </div>
            <span class="hidden md:block text-sm font-medium text-gray-700 group-hover:text-gray-900 transition-colors duration-150"><%= current_user.full_name %></span>
            <svg class="hidden md:block h-4 w-4 text-gray-400 group-hover:text-gray-500 transition-colors duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- User Dropdown Menu -->
          <div data-dropdown-target="menu"
               class="hidden absolute right-0 z-10 mt-2 w-64 origin-top-right rounded-lg bg-white shadow-xl ring-1 ring-black ring-opacity-5 focus:outline-none"
               role="menu"
               aria-orientation="vertical">
            <div class="py-2">
              <!-- User Info Header -->
              <div class="px-4 py-3 border-b border-gray-100">
                <div class="flex items-center space-x-3">
                  <div class="h-10 w-10 rounded-full bg-gradient-to-br from-indigo-600 to-indigo-700 flex items-center justify-center text-white font-semibold shadow-sm">
                    <%= current_user.initials %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-900 truncate"><%= current_user.full_name %></p>
                    <p class="text-xs text-gray-500 truncate"><%= current_user.email %></p>
                  </div>
                </div>
                <% if current_workspace.present? %>
                  <div class="mt-2 flex items-center space-x-1.5 text-xs text-gray-500">
                    <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M4.25 2A2.25 2.25 0 002 4.25v2.5A2.25 2.25 0 004.25 9h2.5A2.25 2.25 0 009 6.75v-2.5A2.25 2.25 0 006.75 2h-2.5zm0 9A2.25 2.25 0 002 13.25v2.5A2.25 2.25 0 004.25 18h2.5A2.25 2.25 0 009 15.75v-2.5A2.25 2.25 0 006.75 11h-2.5zm9-9A2.25 2.25 0 0011 4.25v2.5A2.25 2.25 0 0013.25 9h2.5A2.25 2.25 0 0018 6.75v-2.5A2.25 2.25 0 0015.75 2h-2.5zm0 9A2.25 2.25 0 0011 13.25v2.5A2.25 2.25 0 0013.25 18h2.5A2.25 2.25 0 0018 15.75v-2.5A2.25 2.25 0 0015.75 11h-2.5z" clip-rule="evenodd" />
                    </svg>
                    <span class="truncate"><%= current_workspace.name %></span>
                    <% membership = current_user.workspace_memberships.find_by(workspace: current_workspace) %>
                    <% if membership %>
                      <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">
                        <%= membership.role.titleize %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Menu Items -->
              <div class="py-1">
                <%= link_to edit_user_registration_path, class: "group flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors duration-150" do %>
                  <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500 transition-colors duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z" />
                  </svg>
                  <span>Your Profile</span>
                <% end %>
                <%= link_to "#", class: "group flex items-center px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition-colors duration-150" do %>
                  <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500 transition-colors duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 018.82 1h2.36a1 1 0 01.98.804l.331 1.652a6.993 6.993 0 011.929 1.115l1.598-.54a1 1 0 011.186.447l1.18 2.044a1 1 0 01-.205 1.251l-1.267 1.113a7.047 7.047 0 010 2.228l1.267 1.113a1 1 0 01.206 1.25l-1.18 2.045a1 1 0 01-1.187.447l-1.598-.54a6.993 6.993 0 01-1.929 1.115l-.33 1.652a1 1 0 01-.98.804H8.82a1 1 0 01-.98-.804l-.331-1.652a6.993 6.993 0 01-1.929-1.115l-1.598.54a1 1 0 01-1.186-.447l-1.18-2.044a1 1 0 01.205-1.251l1.267-1.114a7.05 7.05 0 010-2.227L1.821 7.773a1 1 0 01-.206-1.25l1.18-2.045a1 1 0 011.187-.447l1.598.54A6.993 6.993 0 017.51 3.456l.33-1.652zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                  </svg>
                  <span>Settings</span>
                <% end %>
              </div>

              <!-- Sign Out -->
              <div class="border-t border-gray-100">
                <%= button_to destroy_user_session_path, method: :delete, class: "group w-full text-left px-4 py-2.5 text-sm text-red-700 hover:bg-red-50 transition-colors duration-150 flex items-center" do %>
                  <svg class="mr-3 h-5 w-5 text-red-400 group-hover:text-red-500 transition-colors duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 015.25 2h5.5A2.25 2.25 0 0113 4.25v2a.75.75 0 01-1.5 0v-2a.75.75 0 00-.75-.75h-5.5a.75.75 0 00-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 00.75-.75v-2a.75.75 0 011.5 0v2A2.25 2.25 0 0110.75 18h-5.5A2.25 2.25 0 013 15.75V4.25z" clip-rule="evenodd" />
                    <path fill-rule="evenodd" d="M19 10a.75.75 0 00-.75-.75H8.704l1.048-.943a.75.75 0 10-1.004-1.114l-2.5 2.25a.75.75 0 000 1.114l2.5 2.25a.75.75 0 101.004-1.114l-1.048-.943h9.546A.75.75 0 0019 10z" clip-rule="evenodd" />
                  </svg>
                  <span>Sign Out</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
