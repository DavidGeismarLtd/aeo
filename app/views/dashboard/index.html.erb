<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Dashboard</h1>
      <p class="mt-2 text-gray-600">Welcome back, <%= current_user.full_name %>!</p>
    </div>

    <div class="bg-white shadow rounded-lg p-6">
      <p class="text-gray-700">Your dashboard content will go here.</p>
      <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, class: "mt-4 inline-block px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700" %>
    </div>
  </div>
</div>

