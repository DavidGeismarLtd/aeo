<div class="bg-white shadow overflow-hidden sm:rounded-md">
  <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
    <h3 class="text-lg leading-6 font-medium text-gray-900">
      Your Brands
    </h3>
    <p class="mt-1 text-sm text-gray-500">
      <%= pluralize(brands.count, "brand") %> being monitored
    </p>
  </div>

  <ul role="list" class="divide-y divide-gray-200">
    <% brands.each do |brand| %>
      <li>
        <div class="px-4 py-4 sm:px-6 hover:bg-gray-50 transition duration-150">
          <div class="flex items-center justify-between">
            <div class="flex items-center min-w-0 flex-1">
              <!-- Brand Icon -->
              <div class="flex-shrink-0">
                <div class="h-12 w-12 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
                  <%= brand.name[0].upcase %>
                </div>
              </div>

              <!-- Brand Info -->
              <div class="min-w-0 flex-1 px-4">
                <div>
                  <p class="text-sm font-medium text-indigo-600 truncate">
                    <%= link_to brand.name, workspace_brand_path(current_workspace, brand), class: "hover:text-indigo-900 transition-colors duration-150" %>
                  </p>
                  <p class="mt-1 flex items-center text-sm text-gray-500">
                    <% if brand.domain.present? %>
                      <svg class="flex-shrink-0 mr-1.5 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
                      </svg>
                      <%= brand.domain %>
                    <% else %>
                      <span class="text-gray-400">No domain set</span>
                    <% end %>
                  </p>
                </div>

                <!-- Metrics -->
                <div class="mt-2 flex items-center space-x-4">
                  <!-- Active Status -->
                  <% if brand.active? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <svg class="-ml-0.5 mr-1.5 h-2 w-2 text-green-400" fill="currentColor" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3" />
                      </svg>
                      Active
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      <svg class="-ml-0.5 mr-1.5 h-2 w-2 text-gray-400" fill="currentColor" viewBox="0 0 8 8">
                        <circle cx="4" cy="4" r="3" />
                      </svg>
                      Inactive
                    </span>
                  <% end %>

                  <!-- Created Date -->
                  <div class="flex items-center text-sm text-gray-500">
                    <svg class="flex-shrink-0 mr-1.5 h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
                    </svg>
                    Added <%= time_ago_in_words(brand.created_at) %> ago
                  </div>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="ml-5 flex-shrink-0 flex items-center space-x-2">
              <%= link_to workspace_brand_path(current_workspace, brand),
                  class: "inline-flex items-center p-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-150",
                  title: "View Details" do %>
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                  <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                </svg>
              <% end %>

              <%= link_to edit_workspace_brand_path(current_workspace, brand),
                  class: "inline-flex items-center p-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-150",
                  title: "Edit Brand" do %>
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </li>
    <% end %>
  </ul>

  <!-- View All Link -->
  <% if brands.count >= 10 %>
    <div class="bg-gray-50 px-4 py-4 sm:px-6 border-t border-gray-200">
      <div class="text-sm text-center">
        <%= link_to workspace_brands_path(current_workspace), class: "font-medium text-indigo-600 hover:text-indigo-500 transition-colors duration-150" do %>
          View all brands
          <span aria-hidden="true"> &rarr;</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

